# Copy to .env and adjust. .env is ignored by Git, keep it that way.
# Values with $ or # belong in single quotes.

# The first admin. Only used while there is no active admin, remove both afterwards.
# At least 8 characters, at most 72 bytes.
OPENCHAT_ADMIN_USERNAME=betreiber
OPENCHAT_ADMIN_PASSWORD=

# Where the host listens. 0.0.0.0 opens it to the network, then use HTTPS.
# OPENCHAT_BIND=127.0.0.1
# OPENCHAT_HOST_PORT=8080

# Self registration. Closed, admins create the accounts.
# OPENCHAT_ALLOW_REGISTRATION=false

# false only for plain HTTP in a trusted network, otherwise nobody can sign in there.
# OPENCHAT_COOKIE_SECURE=true

# Behind a reverse proxy: its public address and the addresses the proxy connects from.
# OPENCHAT_ALLOWED_ORIGINS=https://chat.example.com
# OPENCHAT_TRUSTED_PROXIES=172.16.0.0/12

# Pin a version instead of latest, or use an own build.
# OPENCHAT_IMAGE=ghcr.io/schenna43lp1/openchat:latest
# OPENCHAT_VOLUME=openchat-data
